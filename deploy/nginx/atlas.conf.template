# Venture Atlas — nginx site config (Phase 5a)
#
# Substitute __ATLAS_DOMAIN__ before installing (bootstrap.sh does this).
#
# Layout this config assumes:
#   /srv/atlas/site/            the app  — index.html, vendor/, assets
#   /srv/atlas/data/v<N>/       a release — zarr stores + configs (IMMUTABLE)
#   /srv/atlas/data/current     symlink -> v<N> (the only mutable path)
#
# THE FOUR RULES THAT ARE NOT OPTIONAL (05-COMPONENTS.md §3):
#   1. Serve Zarr dotfiles. The stock "location ~ /\. { deny all; }" snippet 404s
#      .zarray/.zgroup/.zattrs/.zmetadata and the viewer dies silently. It would
#      also break certbot's /.well-known/acme-challenge/ renewal.
#   2. Keep .zmetadata working — it collapses thousands of metadata round-trips
#      into one request per store.
#   3. Cache chunks as immutable. Under a versioned release path they genuinely
#      are, so repeat views cost almost no off-net egress (risk G-1).
#   4. Do not gzip chunk binaries — they are already blosc-compressed. Gzip the
#      JSON only.

# --- redirect http -> https, but leave the ACME challenge reachable ----------
server {
    listen 80;
    listen [::]:80;
    server_name __ATLAS_DOMAIN__;

    # RULE 1 (part a): certbot renewal must not be behind auth or a dotfile deny.
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __ATLAS_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__ATLAS_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ATLAS_DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root /srv/atlas/site;
    index index.html;

    # --- Stage A gate (component C-1) ---------------------------------------
    # Covers the app AND every Zarr chunk, because both are on this one origin.
    # At publication (Stage B / 5d) comment out these two lines and reload —
    # nothing moves, no URL changes.
    auth_basic           "Venture Atlas — review access";
    auth_basic_user_file /etc/nginx/atlas.htpasswd;

    # Same-origin app + data means NO CORS is needed at all. If the data tier
    # later moves to Swift object storage (component E-3) and becomes a second
    # origin, that is where CORS comes back — set it on the Swift container via
    # X-Container-Meta-Access-Control-Allow-Origin, not here.

    # --- RULE 1: dotfiles -----------------------------------------------------
    # Deny ONLY the genuinely sensitive ones. Everything else — crucially the
    # Zarr dotfiles — is served normally because there is no blanket deny rule.
    location ~ /\.(git|ht|env) {
        deny all;
        return 404;
    }

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
        default_type "text/plain";
    }

    # --- many small files ----------------------------------------------------
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    open_file_cache          max=20000 inactive=300s;
    open_file_cache_valid    120s;
    open_file_cache_min_uses 1;
    open_file_cache_errors   off;

    # --- RULE 4: compress the JSON, never the chunks -------------------------
    gzip              on;
    gzip_vary         on;
    gzip_min_length   512;
    gzip_comp_level   5;
    # Note the absence of application/octet-stream: chunk binaries stay
    # untouched. Zarr metadata is mapped to application/json just below, so it
    # does get compressed — which is where the win actually is.
    gzip_types        application/json text/css application/javascript
                      image/svg+xml text/plain;

    # Zarr chunk binaries have no extension, so they fall through to here.
    # Do NOT add a server-level `types { ... }` block to name the Zarr dotfiles:
    # a types block at this level REPLACES the inherited mime.types map entirely
    # rather than extending it, which would silently strip the types from css,
    # js and fonts. Scope it to a nested location instead (below).
    default_type application/octet-stream;

    # --- the manifest is the one mutable thing; never cache it ---------------
    location = /data/current/manifest.json {
        root /srv/atlas;
        disable_symlinks off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    # --- RULE 3: versioned releases are immutable ----------------------------
    # Configs reference /data/v<N>/... so every chunk URL is content-stable.
    #
    # `root`, not `alias`: /data/x resolves to /srv/atlas/data/x either way, but
    # alias does not inherit correctly into nested locations, and we need one.
    location ^~ /data/ {
        root /srv/atlas;
        disable_symlinks off;     # follow the `current` symlink
        autoindex off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;

        # RULE 2: Zarr metadata as JSON, so it parses cleanly and — since
        # gzip_types keys off content-type — actually gets compressed. A
        # consolidated .zmetadata for a large store is worth compressing.
        # add_header does not merge across levels, so the cache header is
        # repeated here deliberately.
        location ~ \.(zarray|zgroup|zattrs|zmetadata)$ {
            root /srv/atlas;
            disable_symlinks off;
            default_type application/json;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
    }

    # --- the app itself: revalidate so a redeploy is picked up ---------------
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # the bundled viewer is content-hashed at build time, so it can be immutable
    location ^~ /vendor/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    access_log /var/log/nginx/atlas.access.log;
    error_log  /var/log/nginx/atlas.error.log;
}
